<Project>

  <!-- Surfaces the archive settings in Visual Studio's UI, by extending the two rules VS already
       ships for the project node:
         ConfigurationGeneralPage         + Context="Project"      -> the General property page
         ConfigurationGeneralBrowseObject + Context="BrowseObject" -> the Properties window (F4)

       Declared in this .targets file rather than in Zipadee.Build.props on purpose. Inside VS
       (but not under a plain `dotnet build`, where the file doesn't exist)
       Microsoft.Managed.DesignTime.targets contributes ~47 further PropertyPageSchema items to
       this project, including those two rules. Rule overrides are applied in MSBuild evaluation
       order, and Microsoft's browse object declares OverrideMode="Replace" - so anything
       declared from .props, which is imported first, gets replaced right back out again. A
       package's .targets is imported late enough to land after them. See issue #4. -->
  <ItemGroup>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules\ConfigurationGeneralPage.xaml">
      <Context>Project</Context>
    </PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules\ConfigurationGeneralBrowseObject.xaml">
      <Context>BrowseObject</Context>
    </PropertyPageSchema>
  </ItemGroup>

  <!-- Computed here, not in Zipadee.Build.props, because $(OutDir) isn't defined yet when
       .props files are imported (before the SDK sets it based on Configuration/TargetFramework). -->
  <PropertyGroup>
    <ZipadeeOutputFormat Condition="'$(ZipadeeOutputFormat)' == ''">Zip</ZipadeeOutputFormat>
    <ZipadeeCompressionLevel Condition="'$(ZipadeeCompressionLevel)' == ''">Normal</ZipadeeCompressionLevel>
    <ZipadeeIncrementalBuild Condition="'$(ZipadeeIncrementalBuild)' == ''">true</ZipadeeIncrementalBuild>

    <!-- Not bundled (see issue #20) - expected on PATH, like any other external tool this
         project shells out to. Bare command name, not a full path: Exec runs through the shell,
         which resolves it via PATH/PATHEXT. No detection chain and no override property (WinRAR,
         below, works the same way) - a deliberate simplification, since these are expected to
         just be normal installed tools. If it's not on PATH, the build fails with Exec's own
         "not recognized" error rather than a bespoke Zipadee validation message. -->
    <ZipadeeSevenZipExe Condition="'$(ZipadeeSevenZipExe)' == ''">7z</ZipadeeSevenZipExe>

    <!-- 7-Zip's -mx= level. Not used for Tar (tar itself doesn't compress), for GZip's tar
         step (only the gzip step after it compresses), or for Rar (uses its own -m0..-m5 scale
         below). -->
    <ZipadeeCompressionLevelValue Condition="'$(ZipadeeCompressionLevel)' == 'Store'">0</ZipadeeCompressionLevelValue>
    <ZipadeeCompressionLevelValue Condition="'$(ZipadeeCompressionLevel)' == 'Fastest'">1</ZipadeeCompressionLevelValue>
    <ZipadeeCompressionLevelValue Condition="'$(ZipadeeCompressionLevel)' == 'Fast'">3</ZipadeeCompressionLevelValue>
    <ZipadeeCompressionLevelValue Condition="'$(ZipadeeCompressionLevel)' == 'Normal'">5</ZipadeeCompressionLevelValue>
    <ZipadeeCompressionLevelValue Condition="'$(ZipadeeCompressionLevel)' == 'Maximum'">7</ZipadeeCompressionLevelValue>
    <ZipadeeCompressionLevelValue Condition="'$(ZipadeeCompressionLevel)' == 'Ultra'">9</ZipadeeCompressionLevelValue>

    <!-- RAR's -m switch only has 6 levels (0-5), a clean 1:1 match for our 6 named levels -
         unlike 7-Zip's sparser 0/1/3/5/7/9 scale above. -->
    <ZipadeeRarCompressionValue Condition="'$(ZipadeeCompressionLevel)' == 'Store'">0</ZipadeeRarCompressionValue>
    <ZipadeeRarCompressionValue Condition="'$(ZipadeeCompressionLevel)' == 'Fastest'">1</ZipadeeRarCompressionValue>
    <ZipadeeRarCompressionValue Condition="'$(ZipadeeCompressionLevel)' == 'Fast'">2</ZipadeeRarCompressionValue>
    <ZipadeeRarCompressionValue Condition="'$(ZipadeeCompressionLevel)' == 'Normal'">3</ZipadeeRarCompressionValue>
    <ZipadeeRarCompressionValue Condition="'$(ZipadeeCompressionLevel)' == 'Maximum'">4</ZipadeeRarCompressionValue>
    <ZipadeeRarCompressionValue Condition="'$(ZipadeeCompressionLevel)' == 'Ultra'">5</ZipadeeRarCompressionValue>

    <!-- SFX (self-extracting .exe): 7-Zip's SFX modules can only self-extract a 7z payload, so
         this only applies to (and is only valid for) the SevenZip format - see
         ZipadeeValidateArchiveSettings. Bare -sfx (no module path) rather than pointing at a
         bundled module (see issue #20) - 7-Zip defaults to 7zCon.sfx, found next to whichever
         7z.exe is actually running, which every real full install ships. Console-style
         self-extraction UX rather than the GUI-style 7z.sfx this project used to bundle
         explicitly, but the feature itself needs no configuration either way. Note this relies
         on a real 7z.exe (a full install) being what's on PATH - 7za.exe (the minimal "7-Zip
         Extra" console build) doesn't support -sfx at all. -->
    <ZipadeeSfxArg Condition="'$(ZipadeeCreateSfx)' == 'true'">-sfx</ZipadeeSfxArg>

    <!-- WinRAR: no bundled encoder (proprietary format, see issue #6) - shells out to whatever
         copy of WinRAR the user already has installed and licensed themselves. Same approach as
         7-Zip (see issue #20): expected on PATH, bare command name, no detection chain and no
         override property. If it's not on PATH, the build fails with Exec's own "not recognized"
         error rather than a bespoke Zipadee validation message. -->
    <ZipadeeRarExe Condition="'$(ZipadeeRarExe)' == ''">rar</ZipadeeRarExe>

    <!-- Cab detection: makecab.exe ships in every Windows install (System32), unlike RAR - no
         detection chain needed, just an override property for a nonstandard location. -->
    <ZipadeeMakeCabExe Condition="'$(ZipadeeMakeCabExe)' == ''">$(SystemRoot)\System32\makecab.exe</ZipadeeMakeCabExe>

    <!-- Optional settings-only DDF, found by convention rather than a property to set - same
         base name as the project, in the project root (e.g. ConsoleZip.zparchproj looks for
         ConsoleZip.ddf next to it). Only computed (and only ever non-empty) when it actually
         exists, so every other use of this property can treat "empty" as "not present" without a
         separate Exists() check. Only contains .Set directives (no file list) - the build appends
         its own mandatory identity settings (CabinetNameTemplate/DiskDirectory1/SourceDir) and
         the actual file list itself; see ZipadeeCreateArchive, which also excludes this file from
         the cab's own contents even if it's tracked as a Content item (e.g. so it's visible in
         Solution Explorer) - unlike every other format, where it's just an ordinary file that
         follows the normal Content/None rule. -->
    <ZipadeeCabDdfPath Condition="'$(ZipadeeOutputFormat)' == 'Cab' and Exists('$(MSBuildProjectDirectory)\$(MSBuildProjectName).ddf')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(MSBuildProjectName).ddf'))</ZipadeeCabDdfPath>

    <!-- Cab has no encryption support at all (validated below) and only two compression methods
         - MSZIP (fast, modest ratio) for the two fastest levels, LZX (better ratio, needs more
         memory) for the rest, with CompressionMemory (LZX's dictionary size, valid range 15-21)
         scaling across Normal/Maximum/Ultra. -->
    <ZipadeeCabCompressSetting Condition="'$(ZipadeeCompressionLevel)' == 'Store'">off</ZipadeeCabCompressSetting>
    <ZipadeeCabCompressSetting Condition="'$(ZipadeeCompressionLevel)' != 'Store'">on</ZipadeeCabCompressSetting>
    <ZipadeeCabCompressionTypeSetting Condition="'$(ZipadeeCompressionLevel)' == 'Fastest' or '$(ZipadeeCompressionLevel)' == 'Fast'">MSZIP</ZipadeeCabCompressionTypeSetting>
    <ZipadeeCabCompressionTypeSetting Condition="'$(ZipadeeCompressionLevel)' == 'Normal' or '$(ZipadeeCompressionLevel)' == 'Maximum' or '$(ZipadeeCompressionLevel)' == 'Ultra'">LZX</ZipadeeCabCompressionTypeSetting>
    <ZipadeeCabCompressionMemorySetting Condition="'$(ZipadeeCompressionLevel)' == 'Normal'">15</ZipadeeCabCompressionMemorySetting>
    <ZipadeeCabCompressionMemorySetting Condition="'$(ZipadeeCompressionLevel)' == 'Maximum'">18</ZipadeeCabCompressionMemorySetting>
    <ZipadeeCabCompressionMemorySetting Condition="'$(ZipadeeCompressionLevel)' == 'Ultra'">21</ZipadeeCabCompressionMemorySetting>

    <!-- Cross-format volume splitting (issue #30) - a plain byte count, no unit suffix, matching
         Cab's own MaxDiskSize format most directly; Zip/SevenZip/Rar each need their own switch
         syntax translated from that same plain number (confirmed empirically: 7-Zip's -v defaults
         to bytes with no suffix, but RAR's -v requires an explicit unit letter - "b" here). Empty
         (no effect) for Tar/GZip, which have no splitting support at all - see
         ZipadeeValidateArchiveSettings for the warning when set there anyway. -->
    <ZipadeeMaxVolumeSizeArg Condition="'$(ZipadeeMaxVolumeSize)' != '' and ('$(ZipadeeOutputFormat)' == 'Zip' or '$(ZipadeeOutputFormat)' == 'SevenZip')">-v$(ZipadeeMaxVolumeSize)</ZipadeeMaxVolumeSizeArg>
    <ZipadeeMaxVolumeSizeArg Condition="'$(ZipadeeMaxVolumeSize)' != '' and '$(ZipadeeOutputFormat)' == 'Rar'">-v$(ZipadeeMaxVolumeSize)b</ZipadeeMaxVolumeSizeArg>

    <!-- Filter a ProjectReference's output by pattern (issue #18) - each a ;-separated list of
         wildcard patterns (*, ?) or exact relative file names, matched against the archive-relative
         path (%(TargetPath), see ZipadeeResolveProjectReferenceOutputs) assigned to each file.
         Doesn't touch the project's own Content/None items - those already have full control via
         the item type itself.

         Only applies to what actually reaches @(ZipadeeProjectOutputItem) today: the referenced
         project's compiled assembly, its .deps.json/.runtimeconfig.json/apphost .exe, and any of
         its own Content/None items marked CopyToOutputDirectory. Confirmed empirically that a
         companion .pdb or XML doc-comment file is NOT part of that set for a NoTargets-based
         referencing project like this one - neither GetCopyToOutputDirectoryItems nor GetTargetPath
         returns them (they're placed by the compiler directly, bypassing the copy-to-output
         protocol entirely) - so a pattern like *.pdb has nothing to match against yet. See #18's
         follow-up for pulling those in; this filter works on whatever the set contains regardless.

         Converted to a single regex here rather than split into item-list patterns: turning a
         property containing a wildcard into an item Include makes MSBuild treat it as a filesystem
         glob (confirmed empirically - the same landmine as ZipadeeCabCabinetNameTemplate above),
         and separately, a property function's return value is itself escaped in a way that defeats
         further semicolon-splitting when the result is reused as an Include value (confirmed
         empirically: $(Prop.Replace(',', ';')) used as an Include produces one un-split item, not
         several - Replace's result isn't just displayed with real semicolons, it's protected from
         reinterpretation as one). Building one alternation regex directly at the property level
         sidesteps both problems entirely. ZipadeeValidateArchiveSettings below rejects a pattern
         containing \ - a raw backslash surviving into the regex can throw "unrecognized escape
         sequence" for an unlucky combination of characters after it, and patterns are meant to
         match by name/extension, not by folder. -->
    <ZipadeeProjectOutputExcludeRegex Condition="'$(ZipadeeProjectOutputExclude)' != ''">^(?:$(ZipadeeProjectOutputExclude.Replace('.', '\.').Replace('*', '.*').Replace('?', '.').Replace(';', '|')))$</ZipadeeProjectOutputExcludeRegex>
    <ZipadeeProjectOutputIncludeRegex Condition="'$(ZipadeeProjectOutputInclude)' != ''">^(?:$(ZipadeeProjectOutputInclude.Replace('.', '\.').Replace('*', '.*').Replace('?', '.').Replace(';', '|')))$</ZipadeeProjectOutputIncludeRegex>

    <ZipadeeArchiveExtension Condition="'$(ZipadeeOutputFormat)' == 'Zip'">.zip</ZipadeeArchiveExtension>
    <ZipadeeArchiveExtension Condition="'$(ZipadeeOutputFormat)' == 'SevenZip' and '$(ZipadeeCreateSfx)' == 'true'">.exe</ZipadeeArchiveExtension>
    <ZipadeeArchiveExtension Condition="'$(ZipadeeOutputFormat)' == 'SevenZip' and '$(ZipadeeCreateSfx)' != 'true'">.7z</ZipadeeArchiveExtension>
    <ZipadeeArchiveExtension Condition="'$(ZipadeeOutputFormat)' == 'Tar'">.tar</ZipadeeArchiveExtension>
    <ZipadeeArchiveExtension Condition="'$(ZipadeeOutputFormat)' == 'GZip'">.tar.gz</ZipadeeArchiveExtension>
    <ZipadeeArchiveExtension Condition="'$(ZipadeeOutputFormat)' == 'Rar'">.rar</ZipadeeArchiveExtension>
    <ZipadeeArchiveExtension Condition="'$(ZipadeeOutputFormat)' == 'Cab'">.cab</ZipadeeArchiveExtension>

    <!-- Absolute: the archive Exec below runs with WorkingDirectory set to the staging folder
         (see ZipadeeStagingDir), so a relative path here would resolve against that instead of
         $(OutDir). -->
    <ZipadeeArchiveOutputPath Condition="'$(ZipadeeArchiveOutputPath)' == ''">$(MSBuildProjectDirectory)\$(OutDir)$(MSBuildProjectName)$(ZipadeeArchiveExtension)</ZipadeeArchiveOutputPath>

    <!-- Cab's CabinetNameTemplate needs a numbering placeholder (*) whenever spanning might
         happen - confirmed empirically that a non-templated name silently produces a corrupt,
         unextractable cab once content exceeds the disk size, with no error at all. Safe to
         switch unconditionally otherwise (single-disk output is unaffected either way), but only
         actually adds the placeholder when ZipadeeMaxVolumeSize is set, keeping the default
         (unlimited, single-file) case's output name exactly as before. Must come after
         $(ZipadeeArchiveOutputPath) above - MSBuild properties resolve top-to-bottom, so a
         forward-reference here would silently evaluate against an empty string instead (confirmed
         the hard way: this originally sat above ZipadeeArchiveOutputPath and produced "1.cab"
         instead of "test1.cab" as a result).

         The placeholder is written as %2a, not a literal *: this property's value later gets
         interpolated into a ZipadeeDdfLine item's Include attribute below, and MSBuild treats any
         Include value containing an unescaped * or ? as a filesystem glob to expand against disk -
         not literal text. A literal * here made the whole ".Set CabinetNameTemplate=..." line
         silently disappear from the generated DDF with no error (nothing on disk matched the
         "glob"), while every other line rendered fine. %2a survives property/item evaluation as
         escaped text and is un-escaped back to a real * only when the item is finally used as a
         string (e.g. written to the DDF file), which is exactly what's needed here. -->
    <ZipadeeCabCabinetNameTemplate Condition="'$(ZipadeeMaxVolumeSize)' == ''">$([System.IO.Path]::GetFileName('$(ZipadeeArchiveOutputPath)'))</ZipadeeCabCabinetNameTemplate>
    <ZipadeeCabCabinetNameTemplate Condition="'$(ZipadeeMaxVolumeSize)' != ''">$([System.IO.Path]::GetFileNameWithoutExtension('$(ZipadeeArchiveOutputPath)'))%2a$([System.IO.Path]::GetExtension('$(ZipadeeArchiveOutputPath)'))</ZipadeeCabCabinetNameTemplate>

    <ZipadeeStagingDir Condition="'$(ZipadeeStagingDir)' == ''">$(MSBuildProjectDirectory)\$(IntermediateOutputPath)zipadee-stage\</ZipadeeStagingDir>
    <!-- GZip only: intermediate, uncompressed tar that the final gzip step compresses. Lives in
         obj\, already gitignored, so it's left behind rather than explicitly cleaned up. -->
    <ZipadeeIntermediateTarPath Condition="'$(ZipadeeIntermediateTarPath)' == ''">$(MSBuildProjectDirectory)\$(IntermediateOutputPath)$(MSBuildProjectName).tar</ZipadeeIntermediateTarPath>
    <!-- Cab only: the actual DDF fed to makecab.exe - either auto-generated in full, or the
         convention-found DDF's settings (see ZipadeeCabDdfPath above) plus the build's own
         mandatory/file-list lines appended. Lives in obj\, already gitignored. -->
    <ZipadeeIntermediateDdfPath Condition="'$(ZipadeeIntermediateDdfPath)' == ''">$(MSBuildProjectDirectory)\$(IntermediateOutputPath)$(MSBuildProjectName).ddf</ZipadeeIntermediateDdfPath>

    <!-- What ZipadeeCreateArchive's own Outputs= (below) points MSBuild's staleness check at -
         NOT the same thing as $(ZipadeeArchiveOutputPath) above, which is the real file the
         target writes regardless of this setting. When ZipadeeIncrementalBuild is true this is
         just that same real path, so the normal timestamp comparison applies. When false, this
         is a fresh GUID-suffixed path that can never exist, so MSBuild always considers the
         target out-of-date and reruns it every build.

         Verified empirically which way this needs to go, since it's easy to get backwards: an
         EMPTY Outputs value does not mean "always run" - MSBuild logs "Skipping target ... because
         it has no outputs" and never runs it at all. A guaranteed-nonexistent (not empty) Outputs
         value is what actually forces a rerun. -->
    <ZipadeeCreateArchiveOutputs Condition="'$(ZipadeeIncrementalBuild)' == 'true'">$(ZipadeeArchiveOutputPath)</ZipadeeCreateArchiveOutputs>
    <ZipadeeCreateArchiveOutputs Condition="'$(ZipadeeIncrementalBuild)' != 'true'">$(ZipadeeArchiveOutputPath).always-stale-$([System.Guid]::NewGuid())</ZipadeeCreateArchiveOutputs>
  </PropertyGroup>

  <!-- Runs unconditionally (no Inputs/Outputs) so an invalid Password+Tar/GZip combination is
       always caught, even on a build where ZipadeeCreateArchive itself would otherwise be
       skipped as up-to-date. -->
  <Target Name="ZipadeeValidateArchiveSettings" BeforeTargets="Build">
    <Error Condition="'$(ZipadeePassword)' != '' and ('$(ZipadeeOutputFormat)' == 'Tar' or '$(ZipadeeOutputFormat)' == 'GZip' or '$(ZipadeeOutputFormat)' == 'Cab')"
           Text="Zipadee: a password is set (ZipadeePassword) but there's no encryption support for the Tar, GZip, or Cab output formats. Use Zip, SevenZip, or Rar instead, or remove the password." />
    <Error Condition="'$(ZipadeeCreateSfx)' == 'true' and '$(ZipadeeOutputFormat)' != 'SevenZip'"
           Text="Zipadee: ZipadeeCreateSfx is set but 7-Zip's SFX modules can only self-extract a 7z payload (confirmed: a zip-format SFX .exe builds without error but fails to extract). Set ZipadeeOutputFormat to SevenZip, or remove ZipadeeCreateSfx." />
    <!-- Confirmed empirically: 7-Zip accepts -sfx and -v together without erroring, but produces
         a broken result - the .exe is just the empty SFX stub (no error, no warning from 7-Zip
         itself), with the actual archive data split into separately-numbered volumes instead. -->
    <Error Condition="'$(ZipadeeCreateSfx)' == 'true' and '$(ZipadeeMaxVolumeSize)' != ''"
           Text="Zipadee: ZipadeeCreateSfx and ZipadeeMaxVolumeSize can't be combined - 7-Zip accepts both together without erroring, but the result is broken (the .exe ends up being just the empty SFX stub, with the real archive data split into separate numbered volumes instead). Remove one or the other." />
    <Error Condition="'$(ZipadeeOutputFormat)' == 'Cab' and !Exists('$(ZipadeeMakeCabExe)')"
           Text="Zipadee: ZipadeeOutputFormat is Cab but makecab.exe wasn't found at '$(ZipadeeMakeCabExe)'. This ships with every Windows install (System32) - if you're on a nonstandard install (or a non-Windows build agent), set ZipadeeMakeCabExe to its location." />
    <Error Condition="'$(ZipadeeMaxVolumeSize)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(ZipadeeMaxVolumeSize)', '^[0-9]+$'))"
           Text="Zipadee: ZipadeeMaxVolumeSize is set to '$(ZipadeeMaxVolumeSize)', but it must be a plain positive integer - a byte count, with no unit suffix like 'k' or 'm'." />
    <!-- Confirmed empirically: makecab hard-rejects a MaxDiskSize that isn't a multiple of
         ClusterSize (512 by default) with its own error, rather than rounding or ignoring it. -->
    <Error Condition="'$(ZipadeeMaxVolumeSize)' != '' and '$(ZipadeeOutputFormat)' == 'Cab' and $([MSBuild]::Modulo($(ZipadeeMaxVolumeSize), 512)) != 0"
           Text="Zipadee: ZipadeeMaxVolumeSize ($(ZipadeeMaxVolumeSize)) must be a multiple of 512 for the Cab format (makecab's default cluster size) - try a round number of KB/MB, e.g. 1440000 for a 1.44MB floppy." />
    <Warning Condition="'$(ZipadeeMaxVolumeSize)' != '' and ('$(ZipadeeOutputFormat)' == 'Tar' or '$(ZipadeeOutputFormat)' == 'GZip')"
             Text="Zipadee: ZipadeeMaxVolumeSize is set but ignored for the Tar and GZip formats - neither has any volume-splitting support. Remove it, or switch to Zip, SevenZip, Rar, or Cab." />
    <Warning Condition="'$(ZipadeeMaxVolumeSize)' != '' and '$(ZipadeeIncrementalBuild)' == 'true' and '$(ZipadeeOutputFormat)' != 'Tar' and '$(ZipadeeOutputFormat)' != 'GZip'"
             Text="Zipadee: ZipadeeMaxVolumeSize splits the archive into multiple numbered files, which incremental build's staleness check can't track precisely - the archive will be rebuilt on every build regardless of ZipadeeIncrementalBuild. Safe (never serves a stale archive), just not optimally fast." />
    <Error Condition="$(ZipadeeProjectOutputExclude.Contains('\'))"
           Text="Zipadee: ZipadeeProjectOutputExclude can't contain \ - patterns match a project reference output file by name or extension (e.g. *.pdb), not by folder. Remove the \ from the pattern." />
    <Error Condition="$(ZipadeeProjectOutputInclude.Contains('\'))"
           Text="Zipadee: ZipadeeProjectOutputInclude can't contain \ - patterns match a project reference output file by name or extension (e.g. *.pdb), not by folder. Remove the \ from the pattern." />
    <Warning Condition="'$(ZipadeeProjectOutputInclude)' != '' and '$(ZipadeeProjectOutputExclude)' == ''"
             Text="Zipadee: ZipadeeProjectOutputInclude is set but ZipadeeProjectOutputExclude isn't, so there's nothing for it to override - it has no effect. Remove it, or set ZipadeeProjectOutputExclude too." />
  </Target>

  <!-- Split out from ZipadeeCreateArchive (rather than inlined at its top) so its Inputs check
       below can see @(ZipadeeProjectOutputItem)'s real resolved file paths - depending on
       @(ProjectReference) directly there would only catch changes to the referencing .csproj
       file itself, not to the referenced project's actual build output. -->
  <Target Name="ZipadeeResolveProjectReferenceOutputs">
    <!-- Referenced projects' build output (P2P references) is pulled in via the standard
         cross-project "copy to output directory" protocol (the same mechanism that copies a
         P2P reference's output next to a normal project's own output), archived at the
         relative path that protocol assigns it. -->
    <MSBuild Projects="@(ProjectReference)" Targets="GetCopyToOutputDirectoryItems" Condition="'@(ProjectReference)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="ZipadeeProjectOutputItem" />
    </MSBuild>

    <!-- GetCopyToOutputDirectoryItems skips the referenced project's own compiled assembly
         when ReferenceOutputAssembly is false - the NoTargets SDK's default for
         ProjectReference, since it isn't being used as a compile-time reference. Without this,
         the archive would be missing the managed assembly a native apphost .exe needs to
         actually run. GetTargetPath fills that gap; it doesn't supply %(TargetPath) metadata
         itself, so it's set explicitly here to just the output filename, matching where the
         apphost/deps/runtimeconfig files already land. -->
    <MSBuild Projects="@(ProjectReference)" Targets="GetTargetPath" Condition="'@(ProjectReference)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="ZipadeeProjectTargetPathItem" />
    </MSBuild>
    <ItemGroup>
      <ZipadeeProjectOutputItem Include="@(ZipadeeProjectTargetPathItem)">
        <TargetPath>%(ZipadeeProjectTargetPathItem.Filename)%(ZipadeeProjectTargetPathItem.Extension)</TargetPath>
      </ZipadeeProjectOutputItem>
    </ItemGroup>

    <!-- ZipadeeProjectOutputExclude/Include (issue #18) - removes any item whose TargetPath
         matches the exclude pattern, unless the include pattern matches it too (an override, not
         an additional filter to also satisfy - a file forced back in by Include doesn't also need
         to dodge Exclude). Both regexes are '' (no effect) unless their property is set, so this
         is a no-op - matching every project's behavior before this feature existed - when neither
         is set. -->
    <ItemGroup>
      <ZipadeeProjectOutputItem Remove="@(ZipadeeProjectOutputItem)"
        Condition="'$(ZipadeeProjectOutputExcludeRegex)' != ''
                   and $([System.Text.RegularExpressions.Regex]::IsMatch('%(ZipadeeProjectOutputItem.TargetPath)', '$(ZipadeeProjectOutputExcludeRegex)'))
                   and ('$(ZipadeeProjectOutputIncludeRegex)' == '' or !$([System.Text.RegularExpressions.Regex]::IsMatch('%(ZipadeeProjectOutputItem.TargetPath)', '$(ZipadeeProjectOutputIncludeRegex)')))" />
    </ItemGroup>
  </Target>

  <Target Name="ZipadeeCreateArchive"
          AfterTargets="Build"
          DependsOnTargets="ZipadeeValidateArchiveSettings;ZipadeeResolveProjectReferenceOutputs"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(Content);@(ZipadeeProjectOutputItem);$(ZipadeeCabDdfPath)"
          Outputs="$(ZipadeeCreateArchiveOutputs)">

    <!-- Only Content items get archived - None items are deliberately ignored, so a project
         file can hold files it doesn't want in the archive without them silently ending up in
         the output. Files already in the project, or linked in from elsewhere on disk via
         %(Link) (VS's "Add Existing Item > Add as Link"), are archived under their
         project-relative path or %(Link) path.

         The Cab settings-only DDF (see ZipadeeCabDdfPath above) is excluded here even when
         tracked as a Content item - unlike every other format, where it's just an ordinary file
         and follows the rule above like anything else. %(FullPath) is used for the comparison
         (batching over that metadata) rather than the item's Identity/Include spec, since the
         latter varies with however the file happened to be included (relative path, %(Link), a
         wildcard) while %(FullPath) is always the same canonical path. -->
    <ItemGroup>
      <ZipadeeArchiveItem Include="@(Content)" Condition="'$(ZipadeeCabDdfPath)' == '' or '%(FullPath)' != '$(ZipadeeCabDdfPath)'" />
    </ItemGroup>
    <ItemGroup>
      <ZipadeeArchiveItem>
        <ZipadeeArchivePath Condition="'%(ZipadeeArchiveItem.Link)' != ''">%(ZipadeeArchiveItem.Link)</ZipadeeArchivePath>
        <ZipadeeArchivePath Condition="'%(ZipadeeArchiveItem.Link)' == ''">%(ZipadeeArchiveItem.Identity)</ZipadeeArchivePath>
      </ZipadeeArchiveItem>
    </ItemGroup>
    <ItemGroup>
      <ZipadeeArchiveItem Include="@(ZipadeeProjectOutputItem)">
        <ZipadeeArchivePath>%(ZipadeeProjectOutputItem.TargetPath)</ZipadeeArchivePath>
      </ZipadeeArchiveItem>
    </ItemGroup>

    <!-- 7-Zip's command line can't rename an entry on the way in, so the only reliable way to
         put linked files and project outputs at their expected in-archive path is to stage
         copies of everything into a scratch folder laid out exactly like the archive, then zip
         that whole folder. Wiped and rebuilt each time this target actually runs (per the
         Inputs/Outputs check above) so removed items don't linger as stale staged files. -->
    <RemoveDir Directories="$(ZipadeeStagingDir)" Condition="Exists('$(ZipadeeStagingDir)')" />
    <Copy SourceFiles="@(ZipadeeArchiveItem)"
          DestinationFiles="@(ZipadeeArchiveItem->'$(ZipadeeStagingDir)%(ZipadeeArchivePath)')"
          Condition="'@(ZipadeeArchiveItem)' != ''" />

    <MakeDir Directories="$(OutDir)" Condition="!Exists('$(OutDir)')" />

    <Delete Files="$(ZipadeeArchiveOutputPath)" Condition="Exists('$(ZipadeeArchiveOutputPath)')" />

    <!-- Volume-split output (ZipadeeMaxVolumeSize) doesn't produce $(ZipadeeArchiveOutputPath)
         itself, so the Delete above never catches it - clean up any volumes left over from a
         previous build here instead, covering both naming conventions in use across formats:
         name.ext.NNN (Zip/SevenZip) and name*.ext, e.g. name.partN.ext or nameN.ext (Rar/Cab). -->
    <ItemGroup Condition="'$(ZipadeeMaxVolumeSize)' != ''">
      <ZipadeeStaleVolumeFile Include="$(ZipadeeArchiveOutputPath).*" />
      <ZipadeeStaleVolumeFile Include="$([System.IO.Path]::GetDirectoryName('$(ZipadeeArchiveOutputPath)'))\$([System.IO.Path]::GetFileNameWithoutExtension('$(ZipadeeArchiveOutputPath)'))*$([System.IO.Path]::GetExtension('$(ZipadeeArchiveOutputPath)'))" />
    </ItemGroup>
    <Delete Files="@(ZipadeeStaleVolumeFile)" Condition="'$(ZipadeeMaxVolumeSize)' != ''" />

    <!-- The password is passed as an environment variable and referenced as a %-placeholder in
         the command text, rather than embedded directly in it - MSBuild's Exec task always
         echoes its Command text to the build log (which for a PR/CI build gets persisted and
         possibly published), and 7-Zip's CLI has no safer input channel (no stdin/response-file
         support for it). This keeps the literal password out of that log.

         %3B-escaped: MSBuild splits both item lists and this string-array task parameter on
         unescaped ';', which would otherwise silently corrupt (truncate/split) a password that
         happens to contain one. -->
    <PropertyGroup>
      <ZipadeePasswordEnv>ZIPADEE_PASSWORD=$(ZipadeePassword.Replace(';', '%3B'))</ZipadeePasswordEnv>
    </PropertyGroup>

    <!-- Zip: AES-256 needs -mem=AES256 explicitly, since 7-Zip's zip writer otherwise defaults
         to the weak, legacy ZipCrypto method. -->
    <Exec Command="&quot;$(ZipadeeSevenZipExe)&quot; a -tzip -mx=$(ZipadeeCompressionLevelValue) -mem=AES256 -p%ZIPADEE_PASSWORD% $(ZipadeeMaxVolumeSizeArg) -r &quot;$(ZipadeeArchiveOutputPath)&quot; *"
          Condition="'@(ZipadeeArchiveItem)' != '' and '$(ZipadeeOutputFormat)' == 'Zip' and '$(ZipadeePassword)' != ''"
          EnvironmentVariables="$(ZipadeePasswordEnv)"
          WorkingDirectory="$(ZipadeeStagingDir)" />
    <Exec Command="&quot;$(ZipadeeSevenZipExe)&quot; a -tzip -mx=$(ZipadeeCompressionLevelValue) $(ZipadeeMaxVolumeSizeArg) -r &quot;$(ZipadeeArchiveOutputPath)&quot; *"
          Condition="'@(ZipadeeArchiveItem)' != '' and '$(ZipadeeOutputFormat)' == 'Zip' and '$(ZipadeePassword)' == ''"
          WorkingDirectory="$(ZipadeeStagingDir)" />

    <!-- SevenZip: AES-256 is 7z's only encryption method (no -mem switch needed). -mhe=on also
         encrypts filenames/structure, not just file contents - defaulted on whenever a password
         is set, since 7z is the one format here that supports it. $(ZipadeeSfxArg) (empty
         unless ZipadeeCreateSfx is set) prepends the bundled SFX module, producing a
         self-extracting .exe instead of a plain .7z - see ZipadeeArchiveExtension above. -->
    <Exec Command="&quot;$(ZipadeeSevenZipExe)&quot; a -t7z -mx=$(ZipadeeCompressionLevelValue) -mhe=on -p%ZIPADEE_PASSWORD% $(ZipadeeSfxArg) $(ZipadeeMaxVolumeSizeArg) -r &quot;$(ZipadeeArchiveOutputPath)&quot; *"
          Condition="'@(ZipadeeArchiveItem)' != '' and '$(ZipadeeOutputFormat)' == 'SevenZip' and '$(ZipadeePassword)' != ''"
          EnvironmentVariables="$(ZipadeePasswordEnv)"
          WorkingDirectory="$(ZipadeeStagingDir)" />
    <Exec Command="&quot;$(ZipadeeSevenZipExe)&quot; a -t7z -mx=$(ZipadeeCompressionLevelValue) $(ZipadeeSfxArg) $(ZipadeeMaxVolumeSizeArg) -r &quot;$(ZipadeeArchiveOutputPath)&quot; *"
          Condition="'@(ZipadeeArchiveItem)' != '' and '$(ZipadeeOutputFormat)' == 'SevenZip' and '$(ZipadeePassword)' == ''"
          WorkingDirectory="$(ZipadeeStagingDir)" />

    <!-- Tar: no compression setting (tar itself doesn't compress) and no password (validated
         above - ZipadeeValidateArchiveSettings already failed the build if one was set). -->
    <Exec Command="&quot;$(ZipadeeSevenZipExe)&quot; a -ttar -r &quot;$(ZipadeeArchiveOutputPath)&quot; *"
          Condition="'@(ZipadeeArchiveItem)' != '' and '$(ZipadeeOutputFormat)' == 'Tar'"
          WorkingDirectory="$(ZipadeeStagingDir)" />

    <!-- GZip: a raw gzip stream holds one file, not a container, so a multi-file archive needs
         a tar wrapper first - tar the staging folder into an intermediate .tar (uncompressed),
         then gzip-compress that .tar into the final .tar.gz. -->
    <Exec Command="&quot;$(ZipadeeSevenZipExe)&quot; a -ttar -r &quot;$(ZipadeeIntermediateTarPath)&quot; *"
          Condition="'@(ZipadeeArchiveItem)' != '' and '$(ZipadeeOutputFormat)' == 'GZip'"
          WorkingDirectory="$(ZipadeeStagingDir)" />
    <Exec Command="&quot;$(ZipadeeSevenZipExe)&quot; a -tgzip -mx=$(ZipadeeCompressionLevelValue) &quot;$(ZipadeeArchiveOutputPath)&quot; &quot;$(ZipadeeIntermediateTarPath)&quot;"
          Condition="'@(ZipadeeArchiveItem)' != '' and '$(ZipadeeOutputFormat)' == 'GZip'" />

    <!-- Rar: -hp<password> is a single switch encrypting both file contents and headers
         (filenames) - simpler than Zip's -mem=AES256+-p or 7z's -p+-mhe=on pairs above. No SFX
         support for Rar (the existing SFX+non-SevenZip check above already rejects it). -->
    <Exec Command="&quot;$(ZipadeeRarExe)&quot; a -m$(ZipadeeRarCompressionValue) -hp%ZIPADEE_PASSWORD% $(ZipadeeMaxVolumeSizeArg) -r &quot;$(ZipadeeArchiveOutputPath)&quot; *"
          Condition="'@(ZipadeeArchiveItem)' != '' and '$(ZipadeeOutputFormat)' == 'Rar' and '$(ZipadeePassword)' != ''"
          EnvironmentVariables="$(ZipadeePasswordEnv)"
          WorkingDirectory="$(ZipadeeStagingDir)" />
    <Exec Command="&quot;$(ZipadeeRarExe)&quot; a -m$(ZipadeeRarCompressionValue) $(ZipadeeMaxVolumeSizeArg) -r &quot;$(ZipadeeArchiveOutputPath)&quot; *"
          Condition="'@(ZipadeeArchiveItem)' != '' and '$(ZipadeeOutputFormat)' == 'Rar' and '$(ZipadeePassword)' == ''"
          WorkingDirectory="$(ZipadeeStagingDir)" />

    <!-- Cab: makecab.exe needs a DDF listing settings and files rather than command-line
         switches - there's no plain multi-file/wildcard form (that's strictly one source, one
         destination). ZipadeeCabDdfPath, if found (see above), supplies only .Set directives (no
         file list - see the comment on the ZipadeeArchiveItem ItemGroup above); this build always
         appends its own computed settings first (so the user's file can override them), then its
         own mandatory identity settings last (CabinetNameTemplate/DiskDirectory1/SourceDir -
         forced last so nothing in the user's file can point the build at the wrong place), then
         the file list itself, generated from the same @(ZipadeeArchiveItem)/staging mechanism
         every other format uses. Each file list line repeats the relative path in both the source
         and destination column - confirmed empirically that a single-column entry (source only)
         silently flattens subfolder structure in the resulting .cab, while an explicit
         destination column preserves it. -->
    <ReadLinesFromFile File="$(ZipadeeCabDdfPath)"
                        Condition="'$(ZipadeeCabDdfPath)' != ''">
      <Output TaskParameter="Lines" ItemName="ZipadeeUserDdfLine" />
    </ReadLinesFromFile>
    <!-- ZipadeeMaxVolumeSize always overwrites any MaxDiskSize the user's own DDF sets (it's
         added to the mandatory/forced-last lines below, after @(ZipadeeUserDdfLine)) - warn here
         so that silent override isn't a surprise, matching every other mandatory/forced-last
         setting's spirit but called out explicitly since a user might reasonably expect their own
         DDF's MaxDiskSize to win the way CompressionType/CompressionMemory overrides do. -->
    <ItemGroup Condition="'$(ZipadeeMaxVolumeSize)' != '' and '$(ZipadeeOutputFormat)' == 'Cab'">
      <ZipadeeUserDdfMaxDiskSizeLine Include="@(ZipadeeUserDdfLine)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^\s*\.Set\s+MaxDiskSize\s*='))" />
    </ItemGroup>
    <Warning Condition="'@(ZipadeeUserDdfMaxDiskSizeLine)' != ''"
             Text="Zipadee: ZipadeeMaxVolumeSize is set, which overwrites the MaxDiskSize directive already in $(ZipadeeCabDdfPath) - remove one or the other to avoid confusion." />
    <ItemGroup Condition="'$(ZipadeeOutputFormat)' == 'Cab'">
      <!-- Without these, makecab.exe writes setup.inf/setup.rpt (a driver-install-era artifact,
           irrelevant here) into whatever the current working directory happens to be - verified
           this lands in the repo root during a normal build, not obj\ or bin\, since Exec here
           has no WorkingDirectory override. -->
      <ZipadeeDdfLine Include=".Set InfFileName=nul" />
      <ZipadeeDdfLine Include=".Set RptFileName=nul" />
      <ZipadeeDdfLine Include=".Set Compress=$(ZipadeeCabCompressSetting)" />
      <ZipadeeDdfLine Include=".Set CompressionType=$(ZipadeeCabCompressionTypeSetting)" Condition="'$(ZipadeeCabCompressionTypeSetting)' != ''" />
      <ZipadeeDdfLine Include=".Set CompressionMemory=$(ZipadeeCabCompressionMemorySetting)" Condition="'$(ZipadeeCabCompressionMemorySetting)' != ''" />
      <ZipadeeDdfLine Include="@(ZipadeeUserDdfLine)" />
      <ZipadeeDdfLine Include=".Set Cabinet=on" />
      <ZipadeeDdfLine Include=".Set CabinetNameTemplate=$(ZipadeeCabCabinetNameTemplate)" />
      <!-- DiskDirectoryTemplate (applies to every disk uniformly), not DiskDirectory1 (disk 1
           only) - confirmed empirically that DiskDirectory1 alone silently drops every disk past
           the first when spanning is active (makecab's own /V3 log shows it planning all of them
           correctly, it just has nowhere to write them), even though it works fine for the
           common single-disk case too, so there's no downside to using it unconditionally. -->
      <ZipadeeDdfLine Include=".Set DiskDirectoryTemplate=$([System.IO.Path]::GetDirectoryName('$(ZipadeeArchiveOutputPath)'))" />
      <ZipadeeDdfLine Include=".Set SourceDir=$(ZipadeeStagingDir)" />
      <ZipadeeDdfLine Include=".Set MaxDiskSize=$(ZipadeeMaxVolumeSize)" Condition="'$(ZipadeeMaxVolumeSize)' != ''" />
      <ZipadeeDdfLine Include="@(ZipadeeArchiveItem->'&quot;%(ZipadeeArchivePath)&quot; &quot;%(ZipadeeArchivePath)&quot;')" />
    </ItemGroup>
    <WriteLinesToFile File="$(ZipadeeIntermediateDdfPath)"
                       Lines="@(ZipadeeDdfLine)"
                       Overwrite="true"
                       Condition="'@(ZipadeeArchiveItem)' != '' and '$(ZipadeeOutputFormat)' == 'Cab'" />
    <Exec Command="&quot;$(ZipadeeMakeCabExe)&quot; /f &quot;$(ZipadeeIntermediateDdfPath)&quot;"
          Condition="'@(ZipadeeArchiveItem)' != '' and '$(ZipadeeOutputFormat)' == 'Cab'" />

    <Message Importance="high"
              Text="Zipadee: no files to archive - add files to the project (Add &gt; Existing Item) to produce an archive."
              Condition="'@(ZipadeeArchiveItem)' == ''" />

    <!-- Re-globs the same two patterns used for stale-volume cleanup above, but now after the
         archive Execs have actually run, so this picks up whatever volume files were really just
         created (the count/names aren't known ahead of time) for dotnet clean to track. -->
    <ItemGroup Condition="'$(ZipadeeMaxVolumeSize)' != ''">
      <ZipadeeCreatedVolumeFile Include="$(ZipadeeArchiveOutputPath).*" />
      <ZipadeeCreatedVolumeFile Include="$([System.IO.Path]::GetDirectoryName('$(ZipadeeArchiveOutputPath)'))\$([System.IO.Path]::GetFileNameWithoutExtension('$(ZipadeeArchiveOutputPath)'))*$([System.IO.Path]::GetExtension('$(ZipadeeArchiveOutputPath)'))" />
    </ItemGroup>

    <ItemGroup>
      <FileWrites Include="$(ZipadeeArchiveOutputPath)" />
      <FileWrites Include="$(ZipadeeIntermediateTarPath)" Condition="'$(ZipadeeOutputFormat)' == 'GZip'" />
      <FileWrites Include="$(ZipadeeIntermediateDdfPath)" Condition="'$(ZipadeeOutputFormat)' == 'Cab'" />
      <FileWrites Include="@(ZipadeeCreatedVolumeFile)" />
    </ItemGroup>

  </Target>

</Project>
