<Project Sdk="Microsoft.Build.NoTargets/3.7.0">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Zipadee.Build</PackageId>
    <Version>0.1.12</Version>
    <Authors>Jonesie</Authors>
    <Description>Build-time logic for Zipadee Archive Projects: shells out to 7-Zip (expected on PATH) to produce the archive. Not intended for direct use - referenced automatically by the Zipadee Archive Project template.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>
