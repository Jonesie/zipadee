<Project Sdk="Microsoft.Build.NoTargets/3.7.0">

  <PropertyGroup>
    <!-- Not a real compile target - nothing in this project compiles. Microsoft.Build.NoTargets
         still needs a TargetFramework for its restore graph and for MSBuild to negotiate outputs
         when this project references other projects (see M2: project output references). -->
    <TargetFramework>net10.0</TargetFramework>
    <ProjectGuid>$guid1$</ProjectGuid>
  </PropertyGroup>

  <!-- A floating version, not a pinned one - a pinned version here has to be kept in sync by
       hand with whatever's actually published to nuget.org (release.yml, since Zipadee.Build's
       version is tied to the release tag), and it already drifted once: this stayed at 0.1.13
       (a version that only ever existed in a dev machine's local NuGet feed, never published
       anywhere) through several real releases, silently breaking every new project created from
       this template outside that machine - no F4 properties, no archive on build, since
       restoring the package is what pulls in all of that. Floating to the latest published
       version removes the possibility of that drift recurring for new projects. -->
  <ItemGroup>
    <PackageReference Include="Zipadee.Build" Version="*" />
  </ItemGroup>

  <!-- Explicit, not relying on default item globbing to pick it up: confirmed empirically that
       Microsoft.Build.NoTargets projects don't auto-include loose files as implicit None items
       the way a normal Microsoft.NET.Sdk project does (EnableDefaultNoneItems ends up true, but
       the glob that's supposed to act on it never actually adds anything - an ordering quirk
       somewhere in how NoTargets chains into the SDK's own targets). None, not Content, so it
       stays out of the archive - only Content items are archived (see Readme.md itself). -->
  <ItemGroup>
    <None Include="Readme.md" />
  </ItemGroup>

</Project>
