<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copied to this project's own output like any other build artifact - gives
         ProjectOutputFilterTests something real to exclude/include. -->
    <Content Include="extra.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
